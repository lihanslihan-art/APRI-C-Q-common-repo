# Credentials for HTTP Basic auth. Copy to .env and set a real password:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# .env is gitignored and should be mode 600.
AUTH_USER=apri
AUTH_PASS=change-me

# Set to 1 to run with no auth at all. Only for a trusted local network;
# the service refuses to start with empty credentials otherwise.
# ALLOW_NO_AUTH=0
