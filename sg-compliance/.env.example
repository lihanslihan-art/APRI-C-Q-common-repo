# Copy to /etc/sg-compliance/env (root-owned, 0640) on the production host.
# The systemd unit reads this file via `EnvironmentFile=-/etc/sg-compliance/env`.
# Without DEEPSEEK_API_KEY the /api/chat endpoint returns HTTP 503.

DEEPSEEK_API_KEY=

# Optional shared secret to gate /api/news/refresh (append ?key=$SECRET in the timer).
# NEWS_REFRESH_SECRET=
