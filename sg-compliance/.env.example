# Copy to /etc/sg-compliance/env (root-owned, 0640) on the production host.
# The systemd unit reads this file via `EnvironmentFile=-/etc/sg-compliance/env`.
# Without TOKENPLAN_API_KEY the /api/chat endpoint returns HTTP 503.

# Tencent Token Plan key (sk-tp-...). The /api/chat route uses GLM-5.1 via
# https://api.lkeap.cloud.tencent.com/plan/v3 (OpenAI-compatible).
TOKENPLAN_API_KEY=

# Optional shared secret to gate /api/news/refresh (append ?key=$SECRET in the timer).
# NEWS_REFRESH_SECRET=
