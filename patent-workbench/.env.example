# --- this service's own credentials (HTTP Basic) ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
AUTH_USER=apri
AUTH_PASS=change-me
# Set to 1 to run with no auth. The service refuses to start with empty
# credentials otherwise.
# ALLOW_NO_AUTH=0

# --- the corpus search service this one calls for prior art (plan B) ---
CORPUS_API=http://127.0.0.1:3014
# user:password for that service, handed to the agent as $CORPUS_AUTH
CORPUS_AUTH=apri:change-me

# --- agent runtime ---
AGENT_MODEL=claude-opus-5
# Hard per-phase ceiling, enforced by the CLI's own --max-budget-usd.
BUDGET_SCREEN_USD=5
BUDGET_DRAFT_USD=20
# A headless session measures ~283 MB resident and this host has ~1.2 GB free.
# Raising this past 2 risks the OOM killer taking out the other services.
MAX_CONCURRENT=2

# Paths, only if they move
# UPSTREAM_ROOT=/home/admin/ai_patent_experiments
# CLAUDE_BIN=/home/admin/.nvm/versions/node/v24.16.0/bin/claude
